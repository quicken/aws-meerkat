{
  "name": "aws-code-pipeline-monitor",
  "version": "3.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": "git@github.com:quicken/aws-code-pipeline-monitor.git",
  "author": "marcel <mscherzeru@gmail.com>",
  "license": "MIT",
  "scripts": {
    "test": "jest",
    "lint": "eslint src/ --ext .js,.jsx,.ts,.tsx",
    "build": "./build.sh",
    "bundle": "./build.sh && ./package.sh",
    "docs": "typedoc",
    "start": "node esbuild.watch.js && node --inspect -r dotenv/config ./build/index.js",
    "start:debug": "node esbuild.config.js && node --inspect-brk -r dotenv/config ./build/index.js",
    "dev": "ts-node -r dotenv/config src/index.ts",
    "clean": "rm -rf build",
    "build:watch": "node esbuild.watch.js",
    "analyze": "node esbuild.config.js && npx esbuild-visualizer --metadata build/meta.json"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.451.0",
    "@types/aws-lambda": "^8.10.83",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "aws-sdk-client-mock": "^4.1.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^10.6.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-codebuild": "^3.1080.0",
    "@aws-sdk/client-codedeploy": "^3.1080.0",
    "@aws-sdk/client-codepipeline": "^3.1080.0",
    "@aws-sdk/client-dynamodb": "^3.1080.0",
    "@aws-sdk/client-ssm": "^3.1080.0",
    "@aws-sdk/client-sts": "^3.1080.0",
    "@aws-sdk/util-dynamodb": "^3.996.5",
    "fs-extra": "^11.3.6"
  }
}
